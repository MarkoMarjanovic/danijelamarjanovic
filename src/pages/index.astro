---
import Layout from '../layouts/Base.astro';
const main = "<main id=\"main\">\n    <section class=\"hero\" aria-labelledby=\"hero-title\">\n      <div class=\"container hero-grid\">\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\"><span class=\"line-mark\"></span> DANIJELA MARJANOVIĆ · VOŽDOVAC, BEOGRAD</p>\n          <p class=\"hero-credential\">Sertifikovani transakcioni savetnik i psihoterapeut pod supervizijom</p>\n          <h1 id=\"hero-title\">Razumevanje sebe <em>je početak promene.</em></h1>\n          <p class=\"hero-lead\">Ponekad se nađemo u odnosima, osećanjima i situacijama koje nas iznova opterećuju, a ne znamo kako da ih promenimo.</p>\n          <p class=\"hero-sub\">Kroz otvoren razgovor i zajednički rad možemo istražiti šta se krije iza tih teškoća, bolje razumeti sebe i pronaći drugačije načine da se sa njima nosimo.</p>\n          <div class=\"hero-actions\"><button class=\"btn btn-primary js-open-calendar\" type=\"button\">Zakažite uvodni razgovor <span aria-hidden=\"true\">↗</span></button><a class=\"text-link\" href=\"/moj-pristup/\">Saznajte više o mom pristupu <span aria-hidden=\"true\">→</span></a></div>\n          <div class=\"hero-note\"><span class=\"hero-note-dot\" aria-hidden=\"true\"></span> Individualna psihoterapija uživo i online · Partnerska terapija uživo · <a href=\"tel:+381652803981\">065 280 3981</a></div>\n        </div>\n        <div class=\"hero-portrait-wrap\"><div class=\"portrait-arc\" aria-hidden=\"true\"></div><img class=\"hero-portrait\" src=\"/assets/danijela-portrait.webp\" alt=\"Portret Danijele Marjanović, nasmejana i opuštena\" width=\"1254\" height=\"1254\" fetchpriority=\"high\"><div class=\"portrait-caption\"><span class=\"caption-script\">Drago mi je.</span><span>Ja sam Danijela.</span></div></div>\n      </div>\n      <div class=\"hero-bottom\" aria-hidden=\"true\"><span>PROSTOR ZA RAZGOVOR I RAZUMEVANJE</span><span>KORAK PO KORAK</span></div>\n    </section>\n\n    <section class=\"section recognition\" id=\"prepoznajete-se\" aria-labelledby=\"recognition-title\"><div class=\"container recognition-layout\"><div class=\"section-intro\"><p class=\"eyebrow\">MOŽDA VAM JE POZNATO</p><h2 id=\"recognition-title\">Nekad nije lako pronaći <em>prave reči.</em></h2><p>Ne morate imati sve odgovore pre nego što potražite podršku.</p></div><div class=\"recognition-items\"><div class=\"recognition-item\"><span class=\"item-number\">01</span><p>Iznova se nalazite u sličnim nesporazumima i konfliktima, iako želite da bude drugačije.</p></div><div class=\"recognition-item\"><span class=\"item-number\">02</span><p>Teško vam je da postavite granice ili izrazite potrebe bez osećaja krivice.</p></div><div class=\"recognition-item\"><span class=\"item-number\">03</span><p>Primećujete da se određeni obrasci ponavljaju u partnerskim i porodičnim odnosima.</p></div><div class=\"recognition-item\"><span class=\"item-number\">04</span><p>Prolazite kroz životnu promenu, gubitak ili period emocionalne nesigurnosti.</p></div><div class=\"recognition-item\"><span class=\"item-number\">05</span><p>Brige i unutrašnji konflikti vam otežavaju da živite onako kako biste želeli.</p></div></div></div></section>\n\n    <section class=\"section about-section\" id=\"o-meni\" aria-labelledby=\"about-title\"><div class=\"container about-grid\"><div class=\"about-art\"><div class=\"office-photo-placeholder\" role=\"img\" aria-label=\"Planirano mesto za profesionalnu fotografiju Danijele tokom insceniranog razgovora u ordinaciji\"><span class=\"photo-placeholder-label\">FOTOGRAFIJA U PRIPREMI</span><div class=\"photo-placeholder-center\"><span class=\"photo-placeholder-title\">Razgovor u prostoru poverenja.</span><span class=\"photo-placeholder-detail\">Ovde će biti stvarna fotografija Danijele u njenom radnom prostoru, sa odraslom osobom koja glumi klijenta i pristaje na fotografisanje.</span></div></div></div><div class=\"about-copy\"><p class=\"eyebrow\">UPOZNAJMO SE</p><h2 id=\"about-title\">Drago mi je.<br><em>Ja sam Danijela.</em></h2><p class=\"credential\">Sertifikovani transakcioni savetnik i psihoterapeut pod supervizijom</p><p>U svom radu oslanjam se na transakcionu analizu, pristup koji nam pomaže da bolje razumemo kako razmišljamo, osećamo, komuniciramo i gradimo odnose.</p><p>Važno mi je da se tokom susreta osećate prihvaćeno i slobodno da govorite o onome što vas opterećuje. Istovremeno, moj rad podrazumeva aktivan razgovor, otvorena pitanja i povratne informacije.</p><p>Moj cilj nije da vam kažem kako treba da živite, već da vam pomognem da jasnije razumete sebe i pronađete odgovore koji imaju smisla za vas.</p><a href=\"/o-meni/\" class=\"text-link\">Više o meni <span aria-hidden=\"true\">→</span></a></div></div></section>\n\n    <section class=\"section services-section\" id=\"usluge\" aria-labelledby=\"services-title\"><div class=\"container\"><div class=\"section-heading centered\"><p class=\"eyebrow\">NAČINI SARADNJE</p><h2 id=\"services-title\">Prostor za <em>vaš sledeći korak.</em></h2><p>Svaki terapijski proces počinje razgovorom i razumevanjem onoga što je vama važno.</p></div><div class=\"service-grid\"><article class=\"service-card\"><span class=\"service-index\">01 / INDIVIDUALNO</span><h3>Individualna<br><em>psihoterapija</em></h3><p>Prostor za istraživanje osećanja, ličnih odnosa, unutrašnjih konflikata, životnih promena i obrazaca ponašanja.</p><div class=\"service-details\"><span>60 minuta</span><span>Uživo ili online</span></div><div class=\"service-foot\"><span class=\"price\">3.500 <small>RSD</small></span><a href=\"/individualna-psihoterapija/\" class=\"round-arrow\" aria-label=\"Saznajte više o individualnoj psihoterapiji\">↗</a></div></article><article class=\"service-card service-card-alt\"><span class=\"service-index\">02 / PARTNERSKI</span><h3>Partnerska<br><em>psihoterapija</em></h3><p>Prostor za bolje razumevanje odnosa, komunikacije, nesporazuma, konflikata, potreba i očekivanja oba partnera.</p><div class=\"service-details\"><span>60 minuta</span><span>Uživo · Beograd</span></div><div class=\"service-foot\"><span class=\"price\">6.000 <small>RSD</small></span><a href=\"/partnerska-psihoterapija/\" class=\"round-arrow\" aria-label=\"Saznajte više o partnerskoj psihoterapiji\">↗</a></div></article></div></div></section>\n\n    <section class=\"section approach-section\" id=\"pristup\" aria-labelledby=\"approach-title\"><div class=\"container approach-grid\"><div><p class=\"eyebrow\">MOJ TERAPIJSKI PRISTUP</p><h2 id=\"approach-title\">Razgovor u kojem <em>učestvujemo zajedno.</em></h2><p class=\"approach-description\">Verujem da svaka osoba ima kapacitet da razmišlja, razume svoje iskustvo i razvija nove mogućnosti za promenu. Zato terapijski proces posmatram kao saradnju.</p></div><div class=\"approach-list\"><div class=\"approach-item\"><span>01</span><div><h3>Razgovaramo otvoreno.</h3><p>Važno mi je da razumete ono o čemu govorimo, bez nepotrebno komplikovanog stručnog jezika.</p></div></div><div class=\"approach-item\"><span>02</span><div><h3>Istražujemo zajedno.</h3><p>Kroz pitanja i povratne informacije nastojimo da bolje razumemo osećanja, iskustva i obrasce.</p></div></div><div class=\"approach-item\"><span>03</span><div><h3>Dogovaramo ciljeve.</h3><p>Zajedno razmatramo šta želite da promenite i šta bi za vas predstavljalo značajan pomak.</p></div></div><div class=\"approach-item\"><span>04</span><div><h3>Poštujemo vaš tempo.</h3><p>Svaka osoba i svaki proces su drugačiji. Ne postoje univerzalni odgovori niti unapred određeni rezultati.</p></div></div></div></div></section>\n\n    <section class=\"section first-step\" id=\"prvi-korak\" aria-labelledby=\"steps-title\"><div class=\"container\"><div class=\"section-heading centered\"><p class=\"eyebrow\">KAKO ZAPOČINJEMO</p><h2 id=\"steps-title\">Ne morate znati <em>odakle da počnete.</em></h2><p>Prvi korak može da bude jednostavan.</p></div><div class=\"step-grid\"><div class=\"step\"><span class=\"step-num\">01</span><div class=\"step-rule\"></div><h3>Uvodni razgovor</h3><p>Kratak telefonski poziv od 15 minuta da se upoznamo i razjasnimo osnovna pitanja o saradnji.</p></div><div class=\"step\"><span class=\"step-num\">02</span><div class=\"step-rule\"></div><h3>Prvi susret</h3><p>Ukoliko procenimo da je saradnja odgovarajuća, dogovaramo termin prve seanse.</p></div><div class=\"step\"><span class=\"step-num\">03</span><div class=\"step-rule\"></div><h3>Zajednički dogovor</h3><p>Razgovaramo o razlozima dolaska, ciljevima, poverljivosti i daljem radu.</p></div></div><div class=\"center-cta\"><button class=\"btn btn-primary js-open-calendar\" type=\"button\">Pogledajte zakazivanje uvodnog razgovora <span aria-hidden=\"true\">↗</span></button><p>U prototipu je prikazan primer kalendara, bez stvarne rezervacije.</p></div></div></section>\n\n    <section class=\"section info-section\" id=\"informacije\" aria-labelledby=\"info-title\"><div class=\"container info-grid\"><div><p class=\"eyebrow\">PRAKTIČNE INFORMACIJE</p><h2 id=\"info-title\">Sve što treba da znate <em>pre susreta.</em></h2><p>Želim da vaša odluka bude informisana i da lako pronađete praktične odgovore.</p></div><div class=\"info-table\"><div><span>Lokacija</span><strong>Voždovac, Beograd</strong></div><div><span>Individualna seansa</span><strong>60 min · 3.500 RSD</strong></div><div><span>Partnerska seansa</span><strong>60 min · 6.000 RSD</strong></div><div><span>Online seanse</span><strong>Individualna psihoterapija</strong></div><div><span>Jezik rada</span><strong>Srpski</strong></div></div></div></section>\n\n    <section class=\"section faq-section\" id=\"pitanja\" aria-labelledby=\"faq-title\"><div class=\"container faq-grid\"><div><p class=\"eyebrow\">ČESTA PITANJA</p><h2 id=\"faq-title\">Možda se i vi <em>ovo pitate.</em></h2></div><div class=\"faq-list\"><details><summary>Da li moram da znam tačno šta je moj problem?<span aria-hidden=\"true\">+</span></summary><p>Ne. Možete doći i kada osećate da vas nešto opterećuje, ali još nemate jasne reči za to. Prvi susreti služe i tome da zajedno bolje razumemo razlog dolaska.</p></details><details><summary>Da li je psihoterapija samo za ozbiljne krize?<span aria-hidden=\"true\">+</span></summary><p>Ne. Ljudi traže podršku i zbog odnosa, životnih promena, emocija i želje da bolje razumeju sebe.</p></details><details><summary>Da li su dostupne online seanse?<span aria-hidden=\"true\">+</span></summary><p>Da, individualne seanse mogu da se održavaju online kada je takav format odgovarajući.</p></details><details><summary>Da li je ono što kažem poverljivo?<span aria-hidden=\"true\">+</span></summary><p>Poverljivost je važan deo terapijskog odnosa. Na početku saradnje razgovaramo o njenim granicama i relevantnim profesionalnim pravilima.</p></details></div></div></section>\n\n    <section class=\"final-cta\" id=\"kontakt\" aria-labelledby=\"final-title\"><div class=\"container final-inner\"><p class=\"eyebrow\">JEDAN RAZGOVOR MOŽE BITI POČETAK</p><h2 id=\"final-title\">Promena ponekad počinje <em>jednim razgovorom.</em></h2><p>Ne morate unapred znati šta tačno želite da kažete. Možemo početi kratkim razgovorom i videti da li je moj način rada odgovarajući za vas.</p><button class=\"btn btn-light js-open-calendar\" type=\"button\">Pogledajte termine za uvodni poziv <span aria-hidden=\"true\">↗</span></button></div></section>\n  </main>\n  ";
---
<Layout canonicalPath="/" title="Danijela Marjanović | Psihoterapija Voždovac, Beograd" description="Danijela Marjanović — sertifikovani transakcioni savetnik i psihoterapeut pod supervizijom. Individualna i partnerska psihoterapija na Voždovcu.">
<Fragment set:html={main} />
</Layout>
