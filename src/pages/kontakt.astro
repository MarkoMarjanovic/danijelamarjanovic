---
import Layout from '../layouts/Base.astro';
const main = "<main id=\"main\"><section class=\"subhero\"><div class=\"container subhero-inner\"><p class=\"eyebrow\">KONTAKT</p><h1>Prvi korak može biti <em>jednostavan.</em></h1><p class=\"sublead\">Za početak možete pozvati Danijelu i dogovoriti kratak uvodni razgovor. Nije potrebno da unapred detaljno opisujete svoja iskustva.</p></div></section><section class=\"section sub-section\"><div class=\"container contact-grid\"><div class=\"contact-panel\"><p class=\"eyebrow\">POZOVITE DANIJELU</p><h2>15 minuta <em>za prvi razgovor.</em></h2><p>Uvodni telefonski razgovor je prilika za osnovna pitanja i procenu odgovara li vam ovaj način saradnje. Ne predstavlja psihoterapijsku seansu.</p><a class=\"btn btn-primary\" href=\"tel:+381652803981\">Pozovite: 065 280 3981 ↗</a><p class=\"small-note\">Online izbor termina je u pripremi. Trenutno se ne primaju rezervacije putem ovog sajta.</p></div><div><h2>Praktične informacije</h2><div class=\"info-table\"><div><span>Lokacija</span><strong>Voždovac, Beograd</strong></div><div><span>Individualni susreti</span><strong>Uživo ili online</strong></div><div><span>Partnerski susreti</span><strong>Uživo</strong></div><div><span>Jezik</span><strong>Srpski</strong></div><div><span>Trajanje seanse</span><strong>60 minuta</strong></div></div><p class=\"small-note\">Molimo vas da putem običnog telefonskog kontakta ne šaljete detaljne podatke o zdravstvenom stanju. O poverljivosti se razgovara u okviru profesionalnog rada.</p></div></div></section></main>";
---
<Layout title="Kontakt i uvodni razgovor | Danijela Marjanović" description="Kontaktirajte Danijelu Marjanović za informacije o individualnoj i partnerskoj psihoterapiji na Voždovcu i 15-minutnom uvodnom razgovoru." canonicalPath="/kontakt/">
  <Fragment set:html={main} />
</Layout>
