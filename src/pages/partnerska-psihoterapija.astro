---
import Layout from '../layouts/Base.astro';
const main = "<main id=\"main\"><section class=\"subhero\"><div class=\"container subhero-inner\"><p class=\"eyebrow\">PARTNERSKA PSIHOTERAPIJA</p><h1>Razgovor o odnosu <em>bez traženja krivca.</em></h1><p class=\"sublead\">Kada se bliskost, komunikacija ili poverenje nađu pred izazovima, zajednički razgovor može pomoći da oba partnera bolje razumeju šta se među njima događa.</p></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Sa kojim pitanjima parovi dolaze?</h2><div class=\"topic-grid\"><article class=\"topic-card\"><h3>Komunikacija i nesporazumi</h3><p>Kada razgovori često prerastu u rasprave ili se važne potrebe teško izražavaju.</p></article><article class=\"topic-card\"><h3>Konflikti koji se ponavljaju</h3><p>Kada se vraćate istim temama bez osećaja da se čujete i razumete.</p></article><article class=\"topic-card\"><h3>Bliskost i poverenje</h3><p>Kada želite da razgovarate o udaljavanju, očekivanjima, povredama i mogućnostima daljeg odnosa.</p></article><article class=\"topic-card\"><h3>Promene i životne krize</h3><p>Kada spoljašnje okolnosti, roditeljstvo ili važne odluke utiču na partnersku dinamiku.</p></article></div></div></section><section class=\"section sub-section paper-section\"><div class=\"container narrow\"><h2>Šta je cilj zajedničkog rada?</h2><p>Cilj partnerske psihoterapije nije da se ustanovi ko je u pravu ili ko je kriv. Razgovaramo o potrebama, očekivanjima i načinima na koje oboje učestvujete u odnosu.</p><p>U terapijskom procesu važno je da oba partnera imaju prostor da iznesu svoju perspektivu i da zajedno razmotre moguće promene.</p></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Praktične informacije</h2><div class=\"info-table\"><div><span>Trajanje susreta</span><strong>60 minuta</strong></div><div><span>Cena</span><strong>6.000 RSD</strong></div><div><span>Format</span><strong>Samo uživo · Voždovac, Beograd</strong></div><div><span>Jezik</span><strong>Srpski</strong></div></div><p class=\"small-note\">Uvodni razgovor pomaže da razjasnimo da li je ovakav oblik rada odgovarajući za vas.</p></div></section><section class=\"sub-invite\"><div class=\"container narrow\"><h2>Imate pitanja pre prvog susreta?</h2><p>Pozovite Danijelu ili pogledajte kako izgleda uvodni razgovor.</p><a class=\"btn btn-primary\" href=\"/kontakt/\">Kontakt i uvodni razgovor <span aria-hidden=\"true\">↗</span></a></div></section></main>";
---
<Layout title="Partnerska psihoterapija Beograd | Danijela Marjanović" description="Partnerska psihoterapija uživo u Beogradu: komunikacija, konflikti, poverenje i razumevanje dinamike partnerskog odnosa." canonicalPath="/partnerska-psihoterapija/">
  <Fragment set:html={main} />
</Layout>
