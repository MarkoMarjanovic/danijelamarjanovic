---
import Layout from '../layouts/Base.astro';
const main = "<main id=\"main\"><section class=\"subhero\"><div class=\"container subhero-inner\"><p class=\"eyebrow\">INDIVIDUALNA PSIHOTERAPIJA</p><h1>Prostor za <em>bolje razumevanje sebe.</em></h1><p class=\"sublead\">Ponekad nas opterećuju odnosi, emocije ili životne promene za koje nemamo jasan odgovor. Individualna psihoterapija pruža priliku da ih zajedno istražujemo.</p></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Kada individualni rad može imati smisla?</h2><div class=\"topic-grid\"><article class=\"topic-card\"><h3>Partnerski odnosi i komunikacija</h3><p>Kada se nesporazumi ponavljaju, granice je teško postaviti ili se u odnosima gubite između sopstvenih i tuđih potreba.</p></article><article class=\"topic-card\"><h3>Porodični odnosi i obrasci</h3><p>Kada želite bolje da razumete naučene uloge, osećaj krivice, očekivanja i dinamiku odnosa sa članovima porodice.</p></article><article class=\"topic-card\"><h3>Emocionalne teškoće i životne krize</h3><p>Kada prolazite kroz raskid, razvod, preseljenje, gubitak ili period promena i nesigurnosti.</p></article><article class=\"topic-card\"><h3>Anksioznost, stres i samopouzdanje</h3><p>Kada vas brige, strahovi ili unutrašnji konflikti opterećuju, ili želite da istražite načine suočavanja.</p></article></div></div></section><section class=\"section sub-section paper-section\"><div class=\"container narrow\"><h2>Kako radimo?</h2><p>U radu se oslanjam na transakcionu analizu. Razgovaramo o onome što vas opterećuje, istražujemo obrasce mišljenja, osećanja i ponašanja i zajednički dogovaramo ciljeve koji su vama važni.</p><p>Ne postoje univerzalna rešenja ni zagarantovani ishodi. Tempo i pravac rada usklađujemo sa vašim potrebama i mogućnostima.</p><a href=\"/moj-pristup/\" class=\"text-link\">Upoznajte pristup →</a></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Praktične informacije</h2><div class=\"info-table\"><div><span>Trajanje seanse</span><strong>60 minuta</strong></div><div><span>Cena</span><strong>3.500 RSD</strong></div><div><span>Format</span><strong>Uživo · Voždovac, Beograd ili online</strong></div><div><span>Jezik</span><strong>Srpski</strong></div></div></div></section><section class=\"sub-invite\"><div class=\"container narrow\"><h2>Prvi korak je kratak razgovor.</h2><p>Uvodni telefonski razgovor služi da razjasnimo osnovna pitanja i razmotrimo da li je saradnja odgovarajuća.</p><a class=\"btn btn-primary\" href=\"/kontakt/\">Kontakt i uvodni razgovor <span aria-hidden=\"true\">↗</span></a></div></section></main>";
---
<Layout title="Individualna psihoterapija Beograd | Danijela Marjanović" description="Individualna psihoterapija uživo na Voždovcu i online, uz podršku za odnose, životne krize i emocionalne teškoće." canonicalPath="/individualna-psihoterapija/">
  <Fragment set:html={main} />
</Layout>
