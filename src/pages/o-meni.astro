---
import Layout from '../layouts/Base.astro';
const main = "<main id=\"main\"><section class=\"subhero\"><div class=\"container subhero-inner\"><p class=\"eyebrow\">O MENI</p><h1>Drago mi je. <em>Ja sam Danijela.</em></h1><p class=\"sublead\">U radu sa ljudima važni su mi otvoren razgovor, prihvatanje bez osuđivanja i zajedničko istraživanje onoga što vas opterećuje.</p></div></section><section class=\"section sub-section\"><div class=\"container about-detail\"><div><img src=\"/assets/danijela-portrait.webp\" alt=\"Danijela Marjanović\" width=\"1254\" height=\"1254\" loading=\"lazy\" class=\"detail-portrait\" /></div><div><p class=\"eyebrow\">UPOZNAJMO SE</p><h2>Ne verujem u <em>gotova rešenja.</em></h2><p>Verujem u jedinstvenost svake osobe i njenu sposobnost da razmišlja, donosi odluke i menja obrasce koji joj više ne služe.</p><p>Moj rad je aktivan i neposredan. Pažljivo slušam, postavljam pitanja i dajem povratne informacije, ali ne želim da odgovore donosim umesto vas. Zajedno istražujemo šta se događa, kako to razumete i šta biste želeli da bude drugačije.</p><p>Važno mi je da terapijski odnos bude mesto u kojem je moguće razgovarati bez osuđivanja i istovremeno iskreno preispitivati svoje izbore.</p><p class=\"credential\">Sertifikovani transakcioni savetnik i psihoterapeut pod supervizijom</p></div></div></section><section class=\"section sub-section paper-section\"><div class=\"container narrow\"><h2>Obrazovanje i profesionalni razvoj</h2><p>Moje obrazovanje i usavršavanje povezani su sa Institutom Psihopolis i Fakultetom za medije i komunikacije, uključujući propedeutiku, transakcionu analizu u poslovanju i transakcionu psihoterapiju.</p><p>Precizni nazivi programa, sertifikata i ustanova biće usklađeni sa dokumentacijom pre javnog pokretanja sajta.</p></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Kako razumem promenu</h2><p>Promena ne mora da počne velikim korakom. Ponekad počinje time što prepoznamo osećanja, uloge i obrasce u odnosima koji se dugo ponavljaju.</p><p>Želim da se u terapijskom radu osećate kao aktivni učesnik — sa svojim pitanjima, ciljevima i pravom da sami odlučujete o svom životu.</p><a class=\"text-link\" href=\"/moj-pristup/\">Više o mom pristupu →</a></div></section><section class=\"sub-invite\"><div class=\"container narrow\"><h2>Možemo početi jednim razgovorom.</h2><p>Ako želite da saznate kako izgleda prvi korak, pozovite me ili pogledajte informacije o uvodnom razgovoru.</p><a class=\"btn btn-primary\" href=\"/kontakt/\">Kontakt i uvodni razgovor <span aria-hidden=\"true\">↗</span></a></div></section></main>";
---
<Layout title="O meni | Danijela Marjanović" description="Upoznajte Danijelu Marjanović, njen pristup transakcionoj analizi i način rada sa klijentima u Beogradu." canonicalPath="/o-meni/">
  <Fragment set:html={main} />
</Layout>
