---
import Layout from '../layouts/Base.astro';
const main = "<main id=\"main\"><section class=\"subhero\"><div class=\"container subhero-inner\"><p class=\"eyebrow\">MOJ TERAPIJSKI PRISTUP</p><h1>Zajedničko istraživanje, <em>jasan razgovor.</em></h1><p class=\"sublead\">U svom radu oslanjam se na transakcionu analizu — pristup koji naglašava vrednost osobe, sposobnost razmišljanja i mogućnost promena.</p></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Tri polazišta transakcione analize</h2><div class=\"topic-grid\"><article class=\"topic-card\"><h3>Ljudi su OK</h3><p>Svaka osoba ima vrednost i dostojanstvo, bez obzira na iskustva, okolnosti i ponašanja.</p></article><article class=\"topic-card\"><h3>Svako može da misli</h3><p>Ljudi imaju kapacitet da razumeju svoja iskustva, promišljaju i donose odluke.</p></article><article class=\"topic-card\"><h3>Odluke se mogu preispitati</h3><p>Ranije odluke i naučeni obrasci utiču na život, ali ne moraju zauvek određivati buduće izbore.</p></article></div></div></section><section class=\"section sub-section paper-section\"><div class=\"container narrow\"><h2>Saradnja i dogovoreni ciljevi</h2><p>Jedan od važnih principa mog rada jeste dogovor o terapijskim ciljevima. Razgovaramo o tome šta želite da promenite i na koji način ćemo prepoznati značajne pomake.</p><p>Vi ste aktivni učesnik u tom procesu. Moj zadatak nije da donesem odluke umesto vas, već da vam pomognem da bolje razumete sebe i mogućnosti koje imate.</p></div></section><section class=\"section sub-section \"><div class=\"container narrow\"><h2>Otvorena komunikacija</h2><p>Važno mi je da psihološka znanja ne ostanu iza komplikovanih izraza. Nastojim da govorimo jasno i neposredno, tako da razumete šta zajedno istražujemo.</p><p>Tokom susreta aktivno slušam, postavljam pitanja i dajem povratne informacije, uz poštovanje vašeg iskustva, tempa i autonomije.</p></div></section><section class=\"sub-invite\"><div class=\"container narrow\"><h2>Želite da saznate kako počinjemo?</h2><p>Na prvom susretu razgovaramo o vašim očekivanjima, ciljevima i okviru zajedničkog rada.</p><a class=\"btn btn-primary\" href=\"/kontakt/\">Kontakt i uvodni razgovor <span aria-hidden=\"true\">↗</span></a></div></section></main>";
---
<Layout title="Moj pristup — transakciona analiza | Danijela Marjanović" description="Kako Danijela Marjanović primenjuje transakcionu analizu: otvorena komunikacija, saradnja, dogovoreni ciljevi i autonomija klijenta." canonicalPath="/moj-pristup/">
  <Fragment set:html={main} />
</Layout>
